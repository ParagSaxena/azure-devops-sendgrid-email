{
  "manifestVersion": 1,
  "id": "sendgrid-email-with-attachments",
  "version": "1.0.2",
  "name": "SendGrid Email with Attachments",
  "publisher": "phoenix-enterprise",
  "description": "Send email from Azure Pipelines via SendGrid with attachments: file picker, variable paths, and wildcard patterns. Works in Classic and YAML pipelines on any agent OS.",
  "public": true,
  "categories": [
    "Azure Pipelines"
  ],
  "tags": [
    "sendgrid",
    "email",
    "attachments",
    "notification",
    "mail"
  ],
  "targets": [
    {
      "id": "Microsoft.VisualStudio.Services"
    }
  ],
  "icons": {
    "default": "images/extension-icon.png"
  },
  "content": {
    "details": {
      "path": "README.md"
    }
  },
  "links": {
    "getstarted": {
      "uri": "https://github.com/ParagSaxena/azure-devops-sendgrid-email"
    },
    "support": {
      "uri": "https://github.com/ParagSaxena/azure-devops-sendgrid-email/issues"
    },
    "license": {
      "uri": "https://github.com/ParagSaxena/azure-devops-sendgrid-email/blob/main/LICENSE"
    }
  },
  "repository": {
    "type": "git",
    "uri": "https://github.com/ParagSaxena/azure-devops-sendgrid-email"
  },
  "files": [
    {
      "path": "sendgrid-task"
    }
  ],
  "contributions": [
    {
      "id": "sendgrid-email-task",
      "type": "ms.vss-distributed-task.task",
      "targets": [
        "ms.vss-distributed-task.tasks"
      ],
      "properties": {
        "name": "sendgrid-task"
      }
    }
  ]
}
